{
  "name": "ai-wiki-rag",
  "version": "0.1.0",
  "description": "Local RAG over the ai-wiki knowledge base (kb/) using Ollama + LanceDB + BM25, fully on-device.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "tsx src/cli/sync.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "map": "tsx src/cli/map.ts",
    "ask": "tsx src/cli/ask.ts",
    "search": "tsx src/cli/search.ts",
    "serve": "tsx src/server/index.ts",
    "eval": "tsx src/cli/eval.ts",
    "eval:validate": "tsx src/cli/validate-evals.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^8.3.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@lancedb/lancedb": "^0.38.0",
    "apache-arrow": "18.1.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.12.0",
    "turndown": "^7.2.4",
    "umap-js": "^1.4.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

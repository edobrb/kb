# ---- Knowledge base & storage -------------------------------------------
KB_DIR=./kb                 # folder with the markdown knowledge base
DATA_DIR=./data             # where LanceDB, the BM25 index and the manifest live

# ---- Ollama --------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# Embedding runs over every chunk and is prompt-bound, so its size sets a hard floor on ingest time:
# on an M5 Pro, qwen3-embedding:8b does ~2.9 chunks/s (11 h for 114k chunks) against ~24 chunks/s for
# the 0.6b (1.3 h). Same family and instruction format, 1024 dims instead of 4096.
EMBEDDING_MODEL=qwen3-embedding:8b # `ollama pull qwen3-embedding:0.6b`
CHAT_MODEL=qwen3:8b                  # `ollama pull qwen3:8b`  (any chat model works)
# Qwen3-Embedding supports Matryoshka truncation, up to what the model emits (1024 for the 0.6b/4b,
# 4096 for the 8b). Must be <= the model's own width; changing it triggers a full rebuild.
EMBEDDING_DIMENSIONS=1024
EMBED_BATCH_SIZE=16
# Qwen3 chat models "think" before answering; disable for faster answers.
# This is only the default: the web UI's "Reasoning" button and the API's `think` flag override it
# per request, and the reasoning is streamed to the UI when enabled.
CHAT_THINK=false
CHAT_NUM_CTX=32768         # context window; must hold passages + tool results + the answer
CHAT_MAX_TOKENS=4096       # max answer length (num_predict), reserved out of CHAT_NUM_CTX
CHAT_TEMPERATURE=0.2

# ---- Chunking ------------------------------------------------------------
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=60
# Source files are cut at declaration boundaries (a function is the natural unit), so a bit larger.
CODE_CHUNK_TARGET_TOKENS=600
CODE_CHUNK_MAX_TOKENS=900

# ---- Ingest --------------------------------------------------------------
# Documents are embedded in batches of about this many chunks; the manifest is flushed after each batch.
INGEST_BATCH_CHUNKS=256

# ---- Retrieval -----------------------------------------------------------
RETRIEVAL_CANDIDATES=24     # top-k pulled from EACH of vector + BM25 before fusion
RETRIEVAL_TOP_K=6           # chunks that reach the LLM
RETRIEVAL_VECTOR_WEIGHT=1.0
RETRIEVAL_BM25_WEIGHT=1.0
RETRIEVAL_MAX_CHUNKS_PER_DOC=3
# Optional second stage: rerank the fused candidates with the chat model (slower, more precise).
RERANK=none                 # none | llm
# Rewrite follow-up questions into standalone queries before retrieval (uses the chat model).
# Only used when a question is actually retrieved for — see FOLLOWUP_SEARCH below.
QUERY_REWRITE=true

# Continuing a chat does NOT search the knowledge base again: the follow-up reuses the context blocks
# the chat already gathered, and the model calls search(query) itself when the question moves past
# them. That keeps a conversation on the passages its earlier answers were built from (and makes a
# follow-up much faster). Set FOLLOWUP_SEARCH=true to run a fresh retrieval pass on every turn.
FOLLOWUP_SEARCH=false
FOLLOWUP_CARRY_MAX_BLOCKS=24    # blocks a follow-up may carry (cited ones survive first)
FOLLOWUP_CARRY_MAX_CHARS=24000  # and the characters they may occupy

# ---- Tools (the chat model searches again / reads whole documents) --------
# The answering model gets two tools. search(query) runs the same hybrid retrieval on a query of its
# own, for when the first pass missed the page (the user's words are not the documents' words, or the
# answer spans pages); passages already in the context are not repeated. fetch_document(source_id,
# section?) reads the rest of a page when a ~450-token passage is cut off. related(source_id) walks
# the knowledge graph one hop — what a page links to, what links to it, the rest of its repository —
# for when no rewording would find the page, because what connects them is a link. All three are
# bounded by the same rounds and character budget. Needs a chat model with tool support
# (`npm run doctor` says).
CHAT_TOOLS=true
TOOL_SEARCH=true            # offer search(query); false leaves only fetch_document
TOOL_SEARCH_TOP_K=4         # new passages one search call returns
TOOL_MAX_ROUNDS=3           # tool rounds before the model must answer
DOC_TOOL_MAX_CHARS=20000    # cap on one tool result (~5k tokens)
TOOL_CHAR_BUDGET=24000      # cap on ALL tool results in one answer; this, not TOOL_MAX_ROUNDS, is
                            # usually what ends the tool loop. Raise it with CHAT_NUM_CTX: keep
                            # passages + budget/3.5 + CHAT_MAX_TOKENS under the window.

# "Extended research" mode in the UI (mode=research on POST /api/ask): the same tools with room to
# be used, and a prompt that tells the model to keep searching and reading before it answers.
RESEARCH_TOP_K=10           # passages the first pass returns (instead of RETRIEVAL_TOP_K)
RESEARCH_TOOL_MAX_ROUNDS=6  # tool rounds before the model must answer
RESEARCH_TOOL_CHAR_BUDGET=40000

# ---- Knowledge graph (src/graph, npm run graph) ---------------------------
# What links to what, and where each document belongs (repository, space, page tree, catalog entity,
# owning team, tag, City Map node) — read out of the frontmatter and the markdown links sync already
# wrote, and rebuilt from the manifest at the end of every ingest. Feeds the related() tool and the
# links overlay on /map.html.
GRAPH=true                  # build data/graph.json.gz during ingest
TOOL_RELATED=true           # offer related(source_id) to the answering model
TOOL_RELATED_LIMIT=12       # related documents one call may list
GRAPH_MAX_HUB_SIZE=60       # a repository / space / module bigger than this contributes no
                            # "same place" neighbours: it would be noise, not a hint

# ---- Evaluation ----------------------------------------------------------
# Model that grades answers in `npm run eval -- --judge`. Defaults to CHAT_MODEL; a larger model
# (e.g. qwen3:14b) gives more reliable grades. It only runs during evals, so it can be slow.
# JUDGE_MODEL=qwen3:14b

# ---- Server --------------------------------------------------------------
PORT=8787
HOST=127.0.0.1

# ---- Providers (for tests / CI without Ollama) ---------------------------
# EMBEDDING_PROVIDER=ollama  # ollama | mock
# CHAT_PROVIDER=ollama       # ollama | mock

# ---- Sources for `npm run sync` (scope in sources.yaml) -------------------
# Developer Portal (Backstage). Bearer token: log in at DEVPORTAL_BASE_URL, open DevTools > Network,
# pick any request to /api/ and copy the Authorization header value (without "Bearer "). User tokens
# expire after ~1 hour; ask the portal team for a static external-access token for unattended runs.
DEVPORTAL_BASE_URL=https://development.teamsystem.com
DEVPORTAL_TOKEN=
# GitLab personal access token with the `read_api` scope (Preferences > Access Tokens).
GITLAB_BASE_URL=https://biosphere.teamsystem.com
GITLAB_TOKEN=
# Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Used to index the Confluence spaces listed in sources.yaml (`confluence.spaces.include`, with tree/title
# filters) and to look up related pages for the GitLab project cards. Both classic and *scoped* tokens work:
# scoped ones are routed through api.atlassian.com automatically (cloudId from <site>/_edge/tenant_info;
# CONFLUENCE_CLOUD_ID skips it).
CONFLUENCE_BASE_URL=https://teamsystem.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# CONFLUENCE_CLOUD_ID=
# Parallel requests per source (GitLab downloads files one by one; 8 is fine)
SYNC_CONCURRENCY=8
# SOURCES_FILE=./sources.yaml
# TAXONOMY_FILE=./taxonomy.yaml

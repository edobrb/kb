# ---- Knowledge base & storage -------------------------------------------
KB_DIR=./kb                 # folder with the markdown knowledge base
DATA_DIR=./data             # where LanceDB, the BM25 index and the manifest live

# ---- Ollama --------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# Embedding runs over every chunk and is prompt-bound, so its size sets a hard floor on ingest time:
# on an M5 Pro, qwen3-embedding:8b does ~2.9 chunks/s (11 h for 114k chunks) against ~24 chunks/s for
# the 0.6b (1.3 h). Same family and instruction format, 1024 dims instead of 4096.
EMBEDDING_MODEL=qwen3-embedding:0.6b # `ollama pull qwen3-embedding:0.6b`
CHAT_MODEL=qwen3:8b                  # `ollama pull qwen3:8b`  (any chat model works)
# Qwen3-Embedding supports Matryoshka truncation, up to what the model emits (1024 for the 0.6b/4b,
# 4096 for the 8b). Must be <= the model's own width; changing it triggers a full rebuild.
EMBEDDING_DIMENSIONS=1024
EMBED_BATCH_SIZE=16
# Qwen3 chat models "think" before answering; disable for faster answers.
# This is only the default: the web UI's "Reasoning" button and the API's `think` flag override it
# per request, and the reasoning is streamed to the UI when enabled.
CHAT_THINK=false
CHAT_NUM_CTX=16384
CHAT_TEMPERATURE=0.2

# ---- Chunking ------------------------------------------------------------
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=60
# Source files are cut at declaration boundaries (a function is the natural unit), so a bit larger.
CODE_CHUNK_TARGET_TOKENS=600
CODE_CHUNK_MAX_TOKENS=900

# ---- Contextual retrieval (https://www.anthropic.com/engineering/contextual-retrieval) ------------
# Before embedding, a chat model that sees the whole document + the project card writes 1-2 sentences
# situating each chunk; they are prepended to the chunk for both the vector and the BM25 index.
# One call situates a whole group of chunks (the document is rendered once with <chunk id=N> markers),
# so the cost is the generated tokens, not the number of chunks. Generation does NOT parallelise on
# Ollama/Metal - aggregate throughput is a constant per model - so the dials that matter are the model
# size (CONTEXT_MODEL), the words per context (CONTEXT_MAX_WORDS) and how many chunks are sent at all
# (CONTEXT_KINDS, CONTEXT_MIN_CHUNKS*). Note that qwen35-architecture models (e.g. ornith-1.5:9b) are
# forced to one slot by Ollama and are a poor fit here.
# Results are cached in DATA_DIR/contexts and never regenerated for unchanged chunks.
CONTEXTUALIZE=true
CONTEXT_MODEL=qwen3:1.7b     # defaults to CHAT_MODEL; ~156 tok/s vs ~49 for an 8b
CONTEXT_NUM_CTX=8192
CONTEXT_GROUP_CHARS=16000    # chunk characters per batched call; must leave room inside CONTEXT_NUM_CTX
CONTEXT_GROUP_CHARS_API=8000 # API reference pages are dense; a smaller group stops the model skipping ids
CONTEXT_MAX_WORDS=30         # words per context - the main time/quality dial
CONTEXT_MAX_DOC_CHARS=16000  # single-chunk retry prompt: head + a window around the chunk
CONTEXT_MAX_TOKENS=120       # token cap for that retry
CONTEXT_KINDS=doc,code,api   # kinds that get an LLM context; project cards never do
CONTEXT_MIN_CHUNKS=2         # documents shorter than this get a deterministic context
CONTEXT_MIN_CHUNKS_CODE=4    # code carries "repo > file > symbol" already, so short files gain little
INGEST_BATCH_CHUNKS=256      # contextualize this many chunks, then embed them (limits model swapping)

# ---- Retrieval -----------------------------------------------------------
RETRIEVAL_CANDIDATES=24     # top-k pulled from EACH of vector + BM25 before fusion
RETRIEVAL_TOP_K=6           # chunks that reach the LLM
RETRIEVAL_VECTOR_WEIGHT=1.0
RETRIEVAL_BM25_WEIGHT=1.0
RETRIEVAL_MAX_CHUNKS_PER_DOC=3
# Optional second stage: rerank the fused candidates with the chat model (slower, more precise).
RERANK=none                 # none | llm
# Rewrite follow-up questions into standalone queries before retrieval (uses the chat model).
QUERY_REWRITE=true

# ---- Evaluation ----------------------------------------------------------
# Model that grades answers in `npm run eval -- --judge`. Defaults to CHAT_MODEL; a larger model
# (e.g. qwen3:14b) gives more reliable grades. It only runs during evals, so it can be slow.
# JUDGE_MODEL=qwen3:14b

# ---- Server --------------------------------------------------------------
PORT=8787
HOST=127.0.0.1

# ---- Providers (for tests / CI without Ollama) ---------------------------
# EMBEDDING_PROVIDER=ollama  # ollama | mock
# CHAT_PROVIDER=ollama       # ollama | mock

# ---- Sources for `npm run sync` (scope in sources.yaml) -------------------
# Developer Portal (Backstage). Bearer token: log in at DEVPORTAL_BASE_URL, open DevTools > Network,
# pick any request to /api/ and copy the Authorization header value (without "Bearer "). User tokens
# expire after ~1 hour; ask the portal team for a static external-access token for unattended runs.
DEVPORTAL_BASE_URL=https://development.teamsystem.com
DEVPORTAL_TOKEN=
# GitLab personal access token with the `read_api` scope (Preferences > Access Tokens).
GITLAB_BASE_URL=https://biosphere.teamsystem.com
GITLAB_TOKEN=
# Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Confluence pages are NOT indexed: the wiki is only searched for pages about each GitLab project
# (sources.yaml `confluence.enrich_projects`). Both classic and *scoped* tokens work: scoped ones are routed
# through api.atlassian.com automatically (cloudId from <site>/_edge/tenant_info; CONFLUENCE_CLOUD_ID skips it).
CONFLUENCE_BASE_URL=https://teamsystem.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# CONFLUENCE_CLOUD_ID=
# Parallel requests per source (GitLab downloads files one by one: 8 is fine for ~40k files)
SYNC_CONCURRENCY=8
# SOURCES_FILE=./sources.yaml
